# ──────────────────────────────────────────────────────────────────────────
# UrbanGuard AI — Environment Configuration Template
# Copy to .env and fill in your values.
# NEVER commit .env to git.
# ──────────────────────────────────────────────────────────────────────────

# ── Google Gemini API (Development / Hackathon) ───────────────────────────
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model to use (gemini-2.0-flash is fast & free-tier eligible)
# Options: gemini-2.0-flash | gemini-1.5-pro | gemini-2.0-flash-thinking-exp
GEMINI_MODEL=gemini-2.0-flash

# ── Google Cloud / Vertex AI (Production / Cloud Run) ─────────────────────
# Set USE_VERTEX_AI=true to route Gemini calls through Vertex AI
# (required for Cloud Run with Application Default Credentials)
USE_VERTEX_AI=false
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# ── Frontend ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Backend CORS ───────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Munich Open Data (optional) ───────────────────────────────────────────
# MUNICH_OPEN311_URL=https://muenchenbesser.de/feed/

# ── Streamlit (optional) ──────────────────────────────────────────────────
URBANGUARD_API_URL=http://localhost:8000
